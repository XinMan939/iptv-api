dist
build
.idea
__pycache__/

# ============================================================
# 运行态产物：每轮更新都会重写，且不参与下一轮计算，
# 提交进 git 只会让仓库无限膨胀（channel_results.db 还是二进制）
# ============================================================

# SQLite 频道结果库（含 WAL/SHM 临时文件）
output/data/channel_results.db
output/data/channel_results.db-wal
output/data/channel_results.db-shm

# 运行状态
output/data/run_state.json

# 日志：3.x 会同时写 .log 与 .jsonl 两份，全部不入库
output/log/*.log
output/log/*.jsonl

# 播放截图目录（open_stream_screenshot 开启时才会产生）
output/screenshots/

# 更新过程中的临时文件
output/*.tmp*

# ------------------------------------------------------------
# 仍会入库（供播放器直连 raw 地址 + 下一轮历史复用）：
#   output/result.txt、output/result.m3u
#   output/ipv4/、output/ipv6/、output/epg/
#   output/data/cache.gz、output/data/frozen.gz
# ------------------------------------------------------------
